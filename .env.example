# ================================
# LLM Provider
# ================================
# OpenAI API key - used by Planner and Analyzer agents for LLM calls
OPENAI_API_KEY=your_openai_api_key_here

# ================================
# DataForSEO
# ================================
# DataForSEO login credentials
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# mock = use fake data locally (default, no API key needed)
# live = call real DataForSEO API
DATAFORSEO_MODE=mock

# ================================
# Database
# ================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/search_intel

# ================================
# App Settings
# ================================
# Application environment
APP_ENV=development

# ================================
# Retry Settings
# ================================
# Maximum number of retries on API failure
MAX_RETRIES=3

# Wait time in seconds before first retry
RETRY_BACKOFF_SECONDS=2

# Maximum wait time for an API call (seconds)
API_TIMEOUT_SECONDS=30

# ================================
# Observability
# ================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO